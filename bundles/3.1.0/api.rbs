# hash.rbs
class Hash
  include Enumerable
  # Perform equality comparison
  def ==: (untyped other) -> bool
  # Get value for specified key
  def []: (untyped key) -> untyped
  # Set value for specified key
  def []=: (untyped key, untyped value) -> self
  # Remove all elements from hash
  def clear: () -> Hash
  # Delete specified key
  def delete: (untyped key) -> (untyped | nil)
  # Execute block for each key and value
  def each: () { (untyped key, untyped value) -> untyped } -> self
  # Check if hash is empty
  def empty?: () -> bool
  # Check if specified key exists
  def has_key?: (untyped key) -> bool
  # Check if specified value exists
  def has_value?: (untyped value) -> bool
  # Return string representation for debugging
  def inspect: () -> String
  # Look the key up from the value
  def key: (untyped value) -> (untyped | nil)
  # Return all keys as array
  def keys: () -> Array[untyped]
  # Return number of elements in hash
  def length: () -> Integer
  # Return new hash merged with another hash
  def merge: (Hash other) -> self
  # Merge hash destructively
  def merge!: (Hash other) -> self
  # Return self as hash
  def to_h: () -> self
  # Return all values as array
  def values: () -> Array[untyped]
  # Make an empty hash
  def self.new: () -> Hash
end
# integer.rbs
class Integer
  # Calculate modulo
  def %: ((Integer | Float) other) -> (Integer | Float)
  # Perform bitwise AND operation
  def &: (Integer other) -> Integer
  # Perform multiplication
  def *: ((Integer | Float) other) -> (Integer | Float)
  # Calculate power
  def **: ((Integer | Float) other) -> Integer
  # Perform addition
  def +: ((Integer | Float) other) -> (Integer | Float)
  # Unary plus operator. Returns self
  def +@: () -> Integer
  # Perform subtraction
  def -: ((Integer | Float) other) -> (Integer | Float)
  # Unary minus operator. Inverts sign
  def -@: () -> Integer
  # Perform division
  def /: ((Integer | Float) other) -> (Integer | Float)
  # Perform less than comparison
  def <: ((Integer | Float) other) -> bool
  # Perform left bit shift
  def <<: (Integer other) -> Integer
  # Perform less than or equal comparison
  def <=: ((Integer | Float) other) -> bool
  # Compare. Returns -1, 0 or 1
  def <=>: ((Integer | untyped) other) -> Integer
  # Perform equality comparison
  def ==: (untyped other) -> bool
  # Perform greater than comparison
  def >: ((Integer | Float) other) -> bool
  # Perform greater than or equal comparison
  def >=: ((Integer | Float) other) -> bool
  # Perform right bit shift
  def >>: (Integer other) -> Integer
  # Perform bitwise XOR operation
  def ^: (Integer other) -> Integer
  # Get value at specified bit position
  def []: (untyped index) -> Integer
  # Get absolute value
  def abs: () -> Integer
  # Return the character for this code
  def chr: () -> String
  # Run the block from self down to the argument
  def downto: (Integer limit) { (Integer block_limit) -> untyped } -> Integer
  # Execute block self times
  def times: () { (Integer index) -> untyped } -> Integer
  # Convert to floating point number
  def to_f: () -> Float
  # Return self as integer value
  def to_i: () -> Integer
  # Convert to string. Base can be specified with argument
  def to_s: (?Integer base) -> String
  # Perform bitwise OR operation
  def |: (Integer other) -> Integer
  # Perform bitwise NOT operation
  def ~: () -> Integer
end
# kernel.rbs
module Kernel
  # Inspect and output object
  def p: (*untyped objects) -> untyped
  # Output object
  def print: (*untyped objects) -> nil
  # Output object with newline
  def puts: (*untyped objects) -> nil
  # Call the block that was given
  def yield: (*untyped arguments) -> untyped
  # Create Proc object
  def proc: () { (untyped argument) -> untyped } -> Proc
  # Create lambda expression
  def lambda: () { (untyped argument) -> untyped } -> Proc
  # The short spelling of lambda
  def `->`: (untyped argument) { (untyped block_argument) -> untyped } -> Proc
end
# nil_class.rbs
class NilClass
  # Return logical NOT
  def !: () -> bool
  # Always returns false
  def &: (untyped other) -> bool
  # Equality as `case` uses it
  def ===: (untyped other) -> bool
  # Returns logical value of argument
  def ^: (untyped other) -> bool
  # Returns "nil"
  def inspect: () -> String
  # Returns true
  def nil?: () -> bool
  # Returns 0.0
  def to_f: () -> Float
  # Returns empty hash
  def to_h: () -> Hash
  # Returns 0
  def to_i: () -> Integer
  # Returns empty string
  def to_s: () -> String
  # Returns logical value of argument
  def |: (untyped other) -> bool
end
# object.rbs
class Object
  include Kernel
  # Comparison operator
  def <=>: (untyped other) -> Integer
  # Perform inequality comparison
  def !=: (untyped other) -> bool
  # Perform equality comparison
  def ==: (untyped other) -> bool
  # Judge case equality
  def ===: (untyped other) -> bool
  # Define a reader and a writer
  def attr_accessor: (*Symbol names) -> nil
  # Define a reader
  def attr_reader: (*Symbol names) -> nil
  # Whether a block was given
  def block_given?: () -> bool
  # Return object class
  def class: () -> Class
  # Duplicate object
  def dup: () -> self
  # End the app
  def exit: (?Integer status) -> nil
  # Mix a module in
  def include: (*untyped modules) -> nil
  # Add a module to this object alone
  def extend: (*untyped modules) -> nil
  # Return string representation for debugging
  def inspect: () -> String
  # Check if instance of specified class or module
  def is_a?: (untyped class_or_module) -> bool
  # Repeat forever
  def loop: () { (nil value) -> untyped } -> nil
  # Check if nil
  def nil?: () -> bool
  # Make what follows private
  def private: (*Symbol names) -> nil
  # Make what follows public
  def public: (*Symbol names) -> nil
  # Raise an exception
  def raise: (?untyped exception, ?String message) -> bot
  # Give other tasks a turn
  def relinquish: () -> bool
  # Wait, in seconds
  def sleep: ((Integer | Float) duration) -> Integer
  # Wait, in milliseconds
  def sleep_ms: (Integer milliseconds) -> Integer
  # Format a string
  def sprintf: (String format, *untyped arguments) -> String
  # Return string representation
  def to_s: () -> String
  # get object method list
  def self.methods: () -> Array[Symbol]
end
# proc.rbs
class Proc
  # Call Proc
  def call: (*untyped arguments) -> untyped
  # Make a Proc
  def self.new: () { (untyped argument) -> untyped } -> Proc
end
# range.rbs
class Range < Enumerable
  # Perform equality comparison
  def ==: (untyped other) -> bool
  # Check if value is included in range
  def ===: (untyped object) -> bool
  # Check if end value is excluded
  def exclude_end?: () -> bool
  # Return start value of range
  def first: () -> untyped
  # Return string representation for debugging
  def inspect: () -> String
  # Return end value of range
  def last: () -> untyped
  # Return string representation
  def to_s: () -> String
  # Execute block for each element in range
  def each: () { (untyped element) -> untyped } -> self
  # Make a Range
  def self.new: (untyped first, untyped last, ?bool exclude_end) -> Range
end
# string.rbs
class String
  # Return logical NOT
  def !: () -> bool
  # Repeat string specified number of times
  def *: (Integer count) -> String
  # Concatenate strings
  def +: (String other) -> String
  # Check if lexicographically smaller
  def <: (String other) -> bool
  # Append string or character code
  def <<: ((String | Integer) string_or_codepoint) -> String
  # Check if lexicographically less than or equal
  def <=: (String other) -> bool
  # Compare lexicographically. Returns -1, 0 or 1
  def <=>: (String other) -> Integer
  # Perform equality comparison
  def ==: (untyped other) -> bool
  # Perform equality comparison (for case statements)
  def ===: (untyped other) -> bool
  # Check if lexicographically greater
  def >: (String other) -> bool
  # Check if lexicographically greater than or equal
  def >=: (String other) -> bool
  # Get character or substring at specified position
  def []: (untyped index_or_range) -> (String | nil)
  # Replace the character or substring there
  def []=: (untyped index_or_range, String replacement) -> String
  # Internal argument check for ljust and rjust
  def __ljust_rjust_argcheck: ((Integer | String) width_or_padding) -> nil
  # Return byte sequence of string as array
  def bytes: () -> Array[Integer]
  # Return the size in bytes, not characters
  def bytesize: () -> Integer
  # Return characters of string as array
  def chars: () -> Array[String]
  # Return string with trailing newline removed
  def chomp: () -> String
  # Remove trailing newline destructively
  def chomp!: () -> (String | nil)
  # Clear string contents
  def clear: () -> String
  # Return string converted to lowercase
  def downcase: () -> String
  # Convert to lowercase destructively
  def downcase!: () -> (String | nil)
  # Execute block for each byte
  def each_byte: () { (Integer byte) -> untyped } -> self
  # Execute block for each character
  def each_char: () { (String character) -> untyped } -> self
  # Execute block for each line
  def each_line: (?String separator, ?chomp: bool) { (String line) -> untyped } -> String
  # Check if string is empty
  def empty?: () -> bool
  # Check if ends with specified string
  def end_with?: (String suffix) -> bool
  # Get byte value at specified position
  def getbyte: (Integer index) -> (Integer | nil)
  # Set the byte value at a position
  def setbyte: (Integer index, Integer byte) -> Integer
  # Check if contains specified string
  def include?: (String other) -> bool
  # Return first position of specified string
  def index: ((String | Integer) substring_or_codepoint, ?Integer offset) -> (Integer | nil)
  # Return string representation for debugging
  def inspect: () -> String
  # Convert to symbol
  def intern: () -> Symbol
  # Return string length
  def length: () -> Integer
  # Return string length
  def size: () -> Integer
  # Return string left-justified to specified width
  def ljust: (Integer width, ?String padding) -> String
  # Return string with leading whitespace removed
  def lstrip: () -> String
  # Remove leading whitespace destructively
  def lstrip!: () -> (String | nil)
  # Return character code of first character
  def ord: () -> Integer
  # Return string right-justified to specified width
  def rjust: (Integer width, ?String padding) -> String
  # Return string with trailing whitespace removed
  def rstrip: () -> String
  # Remove trailing whitespace destructively
  def rstrip!: () -> (String | nil)
  # Get character or substring at specified position
  def slice: (untyped index_or_range) -> (String | nil)
  # Split by delimiter and return array
  def split: (?String separator, ?Integer limit) -> Array[String]
  # Check if starts with specified string
  def start_with?: (String prefix) -> bool
  # Return the string without surrounding whitespace
  def strip: () -> String
  # Remove leading and trailing whitespace destructively
  def strip!: () -> (String | nil)
  # Convert to floating point number
  def to_f: () -> Float
  # Convert to integer
  def to_i: (?Integer base) -> Integer
  # Return self as string
  def to_s: () -> String
  # Convert to symbol
  def to_sym: () -> Symbol
  # Return string with characters replaced
  def tr: (String source, String replacement) -> String
  # Replace characters destructively
  def tr!: (String source, String replacement) -> (String | nil)
  # Return string converted to uppercase
  def upcase: () -> String
  # Convert to uppercase destructively
  def upcase!: () -> (String | nil)
end
# symbol.rbs
class Symbol
  # Compare symbols
  def <=>: ((Symbol | untyped) other) -> Integer
  # Perform equality comparison
  def ==: (untyped other) -> bool
  # Perform equality comparison (for case statements)
  def ===: (untyped other) -> bool
  # Return string representation for debugging
  def inspect: () -> String
  # Return self as symbol
  def to_sym: () -> Symbol
end
