  # Mark every widget for redraw
  def invalidate_all: () -> void
  # Find a widget by id
  def find: (Symbol id) -> FmrbUI::Widget?
  # Move and resize a widget
  def move: (Symbol id, Integer x, Integer y, Integer w, Integer h) -> void
  # Whether the toggle is on
  def on?: (Symbol id) -> bool
  # Set a toggle from the app
  def set_on: (Symbol id, bool on) -> void
  # Change a widget's text
  def set_text: (Symbol id, String text) -> void
  # Set a stepper value from the app
  def set_value: (Symbol id, Integer value) -> bool
  # Read the current stepper value
  def value: (Symbol id) -> Integer
  # Enable or disable a widget
  def set_enabled: (Symbol id, bool flag) -> void
  # Show or hide a widget
  def set_visible: (Symbol id, bool flag) -> void
  # The widgets placed so far
  def widgets: () -> Array[FmrbUI::Widget]
end
class FmrbUI::Widget
  # This widget's id
  def id: () -> Symbol
  # Left edge (canvas coordinates)
  def x: () -> Integer
  # Top edge (canvas coordinates)
  def y: () -> Integer
  # Width in pixels
  def w: () -> Integer
  # Height in pixels
  def h: () -> Integer
  # Whether the next flush redraws it
  def dirty: () -> bool
  # Whether it accepts clicks
  def enabled: () -> bool
  # Whether it is shown
  def visible: () -> bool
  # Text scale, fixed at creation
  def text_size: () -> Integer
  # Whether the point is inside
  def hit?: (Integer px, Integer py) -> bool
  # Move and resize (canvas coordinates)
  def place: (Integer x, Integer y, Integer w, Integer h) -> void
end
