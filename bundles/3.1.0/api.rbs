# array.rbs
class Array
  include Enumerable
  # Set element at specified position
  def []=: (Integer index, untyped value) -> untyped
           | (Integer start, Integer length, untyped value) -> untyped
  # Get element at specified position
  def []: (Integer index) -> untyped
  # Elements that are in both arrays
  def &: (Array other) -> self
  # Concatenate arrays
  def +: (Array other) -> Array
  # Return new array excluding specified elements
  def -: (Array other) -> self
  # Append element to end
  def push: (untyped object) -> Array
  # Whether every element passes
  def all?: (*untyped patterns) -> bool
            | (*untyped patterns) { (untyped element) -> untyped } -> bool
  # Get element at specified position
  def at: (Integer index) -> untyped
  # Remove all elements from array
  def clear: () -> Array
  # Execute block for each element and destructively replace
  def collect!: () { (untyped element) -> untyped } -> Array[untyped]
  # Return the number of elements
  def count: () -> Integer
  # Delete element at specified position
  def delete_at: (Integer index) -> untyped
  # Delete elements for which block returns true
  def delete_if: () { (untyped element) -> untyped } -> self
  # Execute block for each element
  def each: () { (untyped element) -> untyped } -> self
  # Execute block for each index
  def each_index: () { (Integer index) -> untyped } -> self
  # Check if array is empty
  def empty?: () -> bool
  # Get first element
  def first: () -> untyped
  # Check if element is included
  def include?: (untyped object) -> bool
  # Return string representation for debugging
  def inspect: () -> String
  # Join elements and return string
  def join: (?String separator) -> String
  # Get last element
  def last: () -> untyped
  # Return number of elements in array
  def length: () -> Integer
  # The largest element
  def max: () -> untyped
           | () { (untyped left, untyped right) -> untyped } -> untyped
  # The smallest element
  def min: () -> untyped
           | () { (untyped left, untyped right) -> untyped } -> untyped
  # Remove and return last element
  def pop: (?Integer count) -> (untyped | self)
  # Return array without elements the block matches
  def reject: () { (untyped element) -> untyped } -> self
  # Delete the elements the block matches, in place
  def reject!: () { (untyped element) -> untyped } -> self
  # Remove and return first element
  def shift: (?Integer count) -> (untyped | self)
  # Return sorted array
  def sort: () -> self
            | () { (untyped left, untyped right) -> untyped } -> self
  # Sort destructively
  def sort!: () -> self
             | () { (untyped left, untyped right) -> untyped } -> self
  # Get subarray
  def slice: (untyped index_or_range) -> untyped
  # Return array with duplicates removed
  def uniq: () -> self
  # Remove duplicates destructively
  def uniq!: () -> self
  # Prepend element to beginning
  def unshift: (untyped object) -> Array
  # The two arrays joined, without duplicates
  def |: (Array other) -> Array
  # Make an array
  def self.new: (?Integer size, ?untyped object) -> Array
end
# class.rbs
class Class
  # Return class name as string
  def name: () -> String
end
# enumerable.rbs
module Enumerable
  # Run the block for each item
  def each: () { (untyped item) -> untyped } -> untyped
  # Run the block with the item and its position
  def each_with_index: () { (untyped item, Integer index) -> untyped } -> untyped
  # Return an array of what the block gave back
  def map: () { (untyped item) -> untyped } -> Array
  # Turn it into an array
  def to_a: () -> Array
end
# false_class.rbs
class FalseClass < Bool
end
# float.rbs
class Float
  # Calculate modulo
  def %: ((Integer | Float) other) -> Float
  # Perform multiplication
  def *: ((Integer | Float) other) -> Float
  # Calculate power
  def **: ((Integer | Float) other) -> Float
  # Perform addition
  def +: ((Integer | Float) other) -> Float
  # Unary plus operator. Returns self
  def +@: () -> Float
  # Perform subtraction
  def -: ((Integer | Float) other) -> Float
  # Unary minus operator. Inverts sign
  def -@: () -> Float
  # Perform division
  def /: ((Integer | Float) other) -> Float
  # Perform less than comparison
  def <: ((Integer | Float) other) -> bool
  # Perform less than or equal comparison
  def <=: ((Integer | Float) other) -> bool
  # Compare. Returns -1, 0 or 1
  def <=>: ((Integer | Float) other) -> (Integer | nil)
  # Perform equality comparison
  def ==: (untyped other) -> bool
  # Equality as `case` uses it
  def ===: (untyped other) -> bool
  # Perform greater than comparison
  def >: ((Integer | Float) other) -> bool
  # Perform greater than or equal comparison
  def >=: ((Integer | Float) other) -> bool
  # Get absolute value
  def abs: () -> Float
  # Return self as floating point number
  def to_f: () -> Float
  # Convert to integer (truncate)
  def to_i: () -> Integer
  # Convert to string
  def to_s: () -> String
end
# fmrb_app.rbs
class FmrbApp
  type wallclock = { year: uint16, month: uint8, day: uint8, hour: uint8, minute: uint8, second: uint8 }
  type sys_pool_info = { total: uint32, used: uint32, free: uint32, used_blocks: uint32, free_blocks: uint32 }
  type gfx_stats = { cmds: uint32, presents: uint32 }
  type wasm_stats = { running: uint8, apps: uint8, modules: uint8, natives: uint16, pool_total: uint32, pool_used: uint32, pool_high: uint32, traps: uint32 }
  type wasm_app_stats = { pages: uint32, max_pages: uint32, binary_size: uint32, hook_us: uint32, hook_max_us: uint32, calls: uint32 }
  type event = { type: :key_down | :key_up | :mouse_down | :mouse_up | :mouse_move | :mouse_wheel | :gamepad_down | :gamepad_up | :gamepad_axis | :kana_mode, x: int32, y: int32, wx: int32, wy: int32, button: int32, keycode: int32, scancode: int32, modifier: int32, character: int32, delta: int32, gamepad_id: int32, axis: int32, value: int32, mode: int32 }
  @gfx: FmrbGfx
  # The canvas to draw on
  def gfx: () -> FmrbGfx
  # Draws on the whole window, frame too
  def window_gfx: () -> FmrbGfx
  # The app's name
  def name: () -> String
  # Whether it is still running
  def running?: () -> bool
  # Window width in pixels
  def window_width: () -> Integer
  # Window height in pixels
  def window_height: () -> Integer
  # Left edge of the window
  def pos_x: () -> Integer
  # Top edge of the window
  def pos_y: () -> Integer
  # Width of the area the app owns
  def user_area_width: () -> Integer
  # Height of the area the app owns
  def user_area_height: () -> Integer
  # Which machine this is
  def platform: () -> (:esp32 | :linux)
  # Whether it fills the screen
  def fullscreen?: () -> bool
  # Whether the corners are rounded
  def rounded_corners?: () -> bool
  # Whether the close button ends it
  def closable?: () -> bool
  # Whether the window has no frame
  def frameless?: () -> bool
  # Whether the window resizes from its corner
  def resizable?: () -> bool
  # Called once as it starts
  def on_create: () -> void
  # called every frame; draw here
  def on_update: () -> void
  # Called once as it ends
  def on_destroy: () -> void
  # Called when the screen goes to another app
  def on_suspend: () -> void
  # Called when the screen comes back
  def on_resume: () -> void
  # Called once the app is written to an image
  def on_checkpoint: () -> void
  # Called when started from an image
  def on_restore: () -> void
  # Called when its own image is refused
  def on_checkpoint_refused: (String reason) -> void
  # called on key and mouse input
  def on_event: (event ev) -> void
  # Called when the window is resized
  def on_resize: (Integer new_width, Integer new_height) -> void
  # Called when it is asked to close
  def on_quit_request: () -> void
  # Right click or long press, frameless
  def on_frameless_right_click: (event ev) -> void
  # Hit shape: rectangles (frameless window)
  def set_hit_shape: (Array rects) -> bool
  # Hit shape: a mask (FmrbHitMask)
  def set_hit_mask: (FmrbHitMask? mask, ?Integer x, ?Integer y) -> bool
  # A hit mask from dot-art strings
  def hit_mask_from_art: (Array rows, ?transparent: String, ?scale: Integer) -> FmrbHitMask
  # Mark a sprite as part of the hit shape
  def add_hit_sprite: (SpriteInstance sprite, ?FmrbHitMask? mask) -> bool
  # Unmark a sprite
  def remove_hit_sprite: (SpriteInstance sprite) -> void
  # Back to the window rectangle
  def clear_hit_shape: () -> bool
  # Start the app running
  def start: () -> void
  # Stop the app
  def stop: () -> void
  # Let go of what it used
  def destroy: () -> void
  # Ask to be loaded again
  def request_reload: () -> void
  # Open this window's menu
  def request_window_menu: (Integer x, Integer y) -> void
  # Ask "Close <app>?" on the desktop
  def request_close_confirm: () -> void
  # The body that is called over and over
  def main_loop: () -> void
  # Redraw the frame and the title
  def draw_window_frame: () -> void
  # theme page colour by default
  def clear_user_area: () -> void
  # clear_user_area with nothing left out
  def clear_user_area_raw: (Integer color) -> void
  # page background from the system theme
  def theme_bg: () -> Integer
  # ink for text on theme_bg
  def theme_fg: () -> Integer
  # selection / emphasis colour
  def theme_accent: () -> Integer
  # rules, boxes, muted text
  def theme_border: () -> Integer
  # ink on accent or button backgrounds
  def theme_fg_light: () -> Integer
  # Draw a scrollbar down the right edge
  def draw_scrollbar: (Integer scroll, Integer total, Integer visible) -> void
  # Work out where the scrollbar was pressed
  def scrollbar_hit: (Integer click_x, Integer click_y) -> Symbol?
  # Move the window
  def set_window_position: (Integer x, Integer y) -> FmrbApp
  # Ask to go full screen or come back
  def request_fullscreen: (bool on) -> void
  # Switch between full screen and window
  def toggle_fullscreen: () -> void
  # Make a second canvas of its own
  def create_canvas_gfx: (Integer width, Integer height) -> FmrbGfx
  # Let go of a canvas it made
  def delete_canvas_gfx: (FmrbGfx gfx) -> void
  # Whether Ctrl was held
  def ev_ctrl?: (event ev) -> bool
  # Whether Shift was held
  def ev_shift?: (event ev) -> bool
  # Whether Alt was held
  def ev_alt?: (event ev) -> bool
  # Ask to be called on a timer
  def set_timer: (Integer interval) -> Integer
  # Stop a timer
  def clear_timer: (Integer timer_id) -> void
  # Start receiving a kind of notice
  def subscribe: (String topic) -> void
  # Stop receiving a kind of notice
  def unsubscribe: (String topic) -> void
  # Send a notice to everyone
  def publish: (String topic) -> void
  # Send a message to another app
  def send_message: (Integer dest_pid, Integer msg_type, untyped data) -> void
  # Ask for a file chooser
  def request_file_select: (String mode, ?dir: String) -> void
  # request_file_select with nothing left out
  def request_file_select_raw: (String mode) -> void
  # Run a file as an app
  def request_run: (String path) -> void
  # request_run with nothing left out
  def request_run_raw: (String path, Integer prev_pid) -> void
  # Write this app to an image and close
  def checkpoint: () -> String?
  # Move this app to another machine
  def move_to: (String to) -> String?
  # Whether to tidy up when idle
  def idle_gc: () -> bool
  # The language now, "ja" or "en"
  def self.language: () -> String
  # The text on the clipboard
  def self.clipboard: () -> String
  # clipboard with nothing left out
  def self.clipboard_raw: (Integer limit) -> String
  # Put text on the clipboard
  def self.set_clipboard: (String text) -> bool
  # How many times the clipboard changed
  def self.clipboard_gen: () -> Integer
  # Show a small notice at the top right
  def self.notify: (String summary, String body) -> bool
  # notify with nothing left out
  def self.notify_raw: (String summary, String body) -> bool
  # The apps that are running
  def self.ps: () -> Array
  # How many times the app list changed
  def self.ps_gen: () -> Integer
  # Write another app to an image
  def self.checkpoint: (Integer pid) -> String?
  # Move another app to another machine
  def self.move: (Integer pid, String to) -> String?
  # How much memory is free
  def self.heap_info: () -> Hash
  # How much of its own memory is used
  def self.pool_usage: () -> Integer
  # How much of its own memory is used, in bytes
  def self.pool_used: () -> Integer
  # The whole machine's memory
  def self.sys_pool_info: () -> sys_pool_info
  # Read a settings file
  def self.config: (String section_name) -> Array?
  # Microseconds since power-on
  def self.uptime_us: () -> int64
  # Milliseconds since power-on
  def self.uptime_ms: () -> int64
  # The date and time now
  def self.wallclock: () -> wallclock?
  # A tally of the frames sent
  def self.gfx_stats: () -> gfx_stats
  # How the wasm runtime is doing
  def self.wasm_stats: () -> wasm_stats
  # How one wasm app is doing
  def self.wasm_app_stats: (Integer pid) -> wasm_app_stats?
  # Show the mouse pointer
  def self.enable_cursor: () -> void
  # Show or hide the mouse pointer
  def self.set_cursor_visible: (bool visible) -> void
  # Switch kana input (0 off 1 hira 2 kata)
  def self.set_kana_mode: (Integer mode) -> void
  # Tell where the text cursor is (for a PC's IME)
  def self.set_text_cursor: (Integer x, Integer y, Integer h) -> void
  # Whether the machine is muted
  def self.audio_muted?: () -> bool
  # Whether the entry cannot be deleted or renamed
  def self.path_read_only?: (String path) -> bool
  # An app's settings (.app.toml and comment)
  def self.app_meta: (String path) -> Hash[String, String]?
  # How many more bytes can be written where the path lives
  def self.free_bytes: (String path) -> Integer?
  # The machine's volume (0-10)
  def self.audio_volume: () -> Integer
  # Whether WiFi is connected
  def self.wifi_connected?: () -> bool
  # How WiFi is doing
  def self.wifi_info: () -> Hash?
  # The USB devices attached
  def self.usb_devices: () -> Array
  # Start receiving raw USB input
  def self.hid_raw_subscribe: (Integer slot) -> bool
  # Stop receiving raw USB input
  def self.hid_raw_unsubscribe: (Integer slot) -> bool
  # This app's own pid
  def self.pid: () -> Integer
  # The file this app was started from
  def self.script_path: () -> String
  # Collect this app's garbage now
  def self.gc: () -> void
  # The battery's charge in percent
  def self.battery_level: () -> Integer?
  # Whether the battery is charging
  def self.battery_charging?: () -> bool
  # The CRT look now
  def self.crt_state: () -> String
  # Whether Linux commands run here
  def self.linux_available?: () -> bool
  # Start a Linux command in a terminal
  def self.linux_start: (String? cmd, String cwd, Integer cols, Integer rows) -> Integer
  # Read a Linux command's output
  def self.linux_read: (Integer h) -> String?
  # Write to a Linux command
  def self.linux_write: (Integer h, String data) -> Integer
  # Send a signal to a Linux command
  def self.linux_signal: (Integer h, Symbol sig) -> bool
  # A Linux command's exit code
  def self.linux_exit_code: (Integer h) -> Integer?
  # Resize a Linux command's terminal
  def self.linux_resize: (Integer h, Integer cols, Integer rows) -> bool
  # Close a Linux command
  def self.linux_close: (Integer h) -> void
end
# fmrb_audio.rbs
class FmrbAudio
  type nsf_status = { state: uint8, reason: uint8, track: uint8, laps: uint8, gen: uint16, period: uint16, frames: uint32 }
  # Make the sound handler
  def self.new: (FmrbApp app) -> FmrbAudio
  # Play a song file
  def play: (String path) -> void
  # play with nothing left out
  def play_raw: (String path, Integer track) -> void
  # Stop the song
  def stop: () -> void
  # Ask where the song is
  def nsf_status: () -> nsf_status?
  NSF_IDLE: Integer
  NSF_PLAYING: Integer
  NSF_FADING: Integer
  NSF_ENDED: Integer
  NSF_END_SILENCE: Integer
  NSF_END_LOOP: Integer
  NSF_END_LIMIT: Integer
  # Pause the song
  def pause: () -> void
  # Carry on from the pause
  def resume: () -> void
  # Put song data into a slot
  def load_fmsq: (Integer slot_id, bin binary_data) -> void
  # Read a song file into a slot
  def load_fmsq_file: (Integer slot_id, String path) -> void
  # Play the song in a slot
  def play_slot: (Integer slot_id) -> void
  # play_slot with nothing left out
  def play_slot_raw: (Integer slot_id, Integer instance) -> void
  # Set the volume of the music (MAIN) only
  def main_volume=: (Integer percent) -> void
  # Play a recorded sound (WAV)
  def play_wav: (String path) -> bool
  # Stop the WAV that is playing
  def stop_wav: () -> bool
  # Sound one note
  def note_on: (Integer channel, Integer freq) -> void
  # note_on with nothing left out
  def note_on_raw: (Integer channel, Integer freq, Integer volume, Integer duty, Integer sweep) -> void
  # Stop a note
  def note_off: (Integer channel) -> void
end
class NsfHeader
  # Read the title and the rest from a song file
  def self.parse: (String path) -> NsfHeader?
  # The song's title
  def song_name: () -> String
  # Who made it
  def artist: () -> String
  # The rights notice
  def copyright: () -> String
  # How many songs are inside
  def total_songs: () -> Integer
  # Which song plays first
  def starting_song: () -> Integer
end
# fmrb_file.rbs
module FmrbFile
  # Read a whole file
  def self.read: (String path) -> bin?
  # Write a whole file, replacing it
  def self.write: (String path, bin data) -> bool
  # Add to the end of a file
  def self.append: (String path, bin data) -> bool
  # Whether a file or a directory is there
  def self.exist?: (String path) -> bool
  # A file's size in bytes
  def self.size: (String path) -> int64?
  # Delete a file or an empty directory
  def self.delete: (String path) -> bool
  # Make a directory
  def self.mkdir: (String path) -> bool
  # The names in a directory
  def self.list: (String dir) -> Array[String]?
  # list as one String, a name per line
  def self.list_raw: (String dir) -> String?
  # Whether the entry cannot be deleted or renamed
  def self.path_read_only?: (String path) -> bool
  # How many more bytes can be written where the path lives
  def self.free_bytes: (String path) -> int64?
end
# fmrb_gfx.rbs
module FmrbText
  # Cut a text to fit a width in pixels
