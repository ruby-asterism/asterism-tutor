  COLOR_BLUE: Integer
  COLOR_YELLOW: Integer
  COLOR_CYAN: Integer
  COLOR_MAGENTA: Integer
  COLOR_GRAY: Integer
  BLEND_ADD: Integer
  BLEND_XOR: Integer
  # The canvas number
