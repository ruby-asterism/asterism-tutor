module MIDI
  class Device
  # Sound a note
  def note_on: (Integer note) -> void
  # Stop a note
  def note_off: (Integer note) -> void
  # Bend the pitch
  def pitch_bend: (Integer value) -> void
  # Choose an instrument
  def program_change: (Integer program) -> void
  # Send a controller value
  def control_change: (Integer cc, Integer value) -> void
  # Set the loudness
  def volume: (Integer value) -> void
  # Set the left-right position
  def pan: (Integer value) -> void
  # Set the depth of the vibrato
  def modulation: (Integer value) -> void
  # Shape the loudness within a piece
  def expression: (Integer value) -> void
  # Press or release the pedal
  def sustain: (Integer on_off) -> void
  # Sound a note for a set length
  def trigger: (Integer note) -> void
  # Sound several notes at once
  def trigger_batch: (Array events) -> void
  # Stop every note that is sounding
  def all_notes_off: () -> void
  # Stop every sound at once
  def all_sound_off: () -> void
  # Put every controller back
  def reset_all_controllers: () -> void
  # Send a beat marker
  def send_clock: () -> void
  # Send a start marker
  def send_start: () -> void
  # Send a stop marker
  def send_stop: () -> void
  # Send a continue marker
  def send_continue: () -> void
  # Send a device's own data
  def send_sysex: (String data) -> void
  # Whether it is connected
  def connected?: () -> bool
  # The name of what is connected
  def info: () -> Hash
  end
end
