  # Wrap a text into at most two lines
  def wrap_text: (String text, Integer width) -> Array[String]
  # Draw a text wrapped into lines
  def draw_text_lines: (Integer x, Integer y, String text, Integer width, Integer color, Integer line_h) -> Integer
end
class FmrbGfx
  include FmrbText
  type image_info = { id: uint16, width: uint16, height: uint16 }
  type file_info = { exists: bool, size: uint32 }
  type composite_region = { src_x: int16, src_y: int16, dst_x: int16, dst_y: int16, w: int16, h: int16, transparent: bool }
  type video_info = { width: uint16, height: uint16 }
  type video_status = { state: uint8, shown: uint32, dropped: uint32 }
  type picture_info = { width: uint16, height: uint16, format: uint8, bytes: uint32, mtime: uint32 }
  BLACK: Integer
  WHITE: Integer
  RED: Integer
  GREEN: Integer
  BLUE: Integer
  YELLOW: Integer
  CYAN: Integer
  MAGENTA: Integer
  GRAY: Integer
