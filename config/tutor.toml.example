# asterism-tutor settings. Every key is optional (the defaults are shown).
# The LLM key is NOT written here: give it as the environment variable
# ANTHROPIC_API_KEY of the process that runs asterism-tutor.
# The environment (ASTERISM_TUTOR_*, README "Settings") goes over this file,
# and the command's options over both.

[network]
router = "tcp/127.0.0.1:7447"     # the Asterism router (the sim's zenohd is tcp/127.0.0.1:7447)
node = "tutor"                     # this gem's node ID: the device finds */tutor/helper
credentials = ""                   # an Asterism console's .tar for a TLS router (then router may be "")
devices = ["*"]                    # the node IDs that may ask, e.g. ["fmruby-a1b2c3"]; "*" = any
name = "AI helper"                 # the name the device shows

[llm]
provider = "fake"                  # "fake" (no LLM, for tests) or "anthropic"
model = "claude-haiku-5-5"         # or "claude-sonnet-5-5"
max_tokens = 8000
effort = ""                        # "", "low", "medium", "high" ("" = the model's default)
timeout_s = 120

# USD per million tokens, for the daily cost limit (an estimate)
[llm.prices.claude-haiku-5-5]
input = 0.10
cache_write = 0.125
cache_read = 0.01
output = 0.50

[limits]
per_device_per_day = 50
cost_per_day_usd = 1.0             # all devices together
retries = 2                        # times the LLM is asked to fix code that failed the checks

[modes]
make = true                        # false: the device cannot ask for a whole app
fix = true                         # false: the device cannot ask to have its code fixed

[talk]
turns = 4                          # the last turns sent with the next request
forget_min = 30                    # forgotten after this many minutes unused

[store]
result_hours = 24                  # results kept for a device that went away
log_dir = "~/.local/share/asterism-tutor/log"
state_dir = "~/.local/share/asterism-tutor/state"   # results not fetched yet, status.json
doc_max = 65536
piece = 8192

[bundle]
dir = ""                           # "" = made from the sources (or the bundles in the gem); a dir = your own bundles

# The Family mruby sources the gem clones (needs git and the network to GitHub)
[sources]
enabled = true                     # false: the bundles in the gem, no look-ups
dir = ""                           # "" = "sources" next to store.state_dir
core = "https://github.com/family-mruby/fmruby-core.git"
asterism = "https://github.com/ruby-asterism/asterism.git"
branch = "develop"                 # fmruby-core's ref for a firmware version with no release tag
asterism_branch = "main"
search = ["sig/**/*", "flash/app/**/*", "lib/gems/*/mrblib/**/*", "flash/usr/share/doc/**/*", "doc/reference/**/*"]
exclude = ["flash/app/test/**/*", "flash/app/game/mahjong/**/*"]
rb_max_kb = 32                     # a bigger .rb is left out of search
refresh_hours = 24
git_timeout_s = 300

# The LLM's tools (search_source, read_source) over the sources
[lookup]
rounds = 4                         # rounds of look-ups in one request (0 = no tools)
hits = 30                          # lines one search returns, at most
lines = 120                        # lines one read returns, at most

[jobs]
workers = 2
stop_grace_s = 8                   # on SIGTERM, how long the requests being worked on are waited for
