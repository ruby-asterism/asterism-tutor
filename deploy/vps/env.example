# deploy/vps/.env of asterism-tutor: copy this file to .env (chmod 600) and
# change what you need (docs/install.md). docker compose reads it for the
# ${...} of docker-compose.yml, and the tutor gets every line as its
# environment (so the ASTERISM_TUTOR_* lines and ANTHROPIC_API_KEY reach it).

# The image: the published one, ghcr.io/ruby-asterism/asterism-tutor:<version>.
# update.sh writes the version it pulled. Building it here instead
# (docker-compose.build.yml, update.sh --build): a name of your own, e.g.
# TUTOR_IMAGE=asterism-tutor-local, so a pull never replaces it.
TUTOR_IMAGE=ghcr.io/ruby-asterism/asterism-tutor
TUTOR_VERSION=0.3.1

# The console's compose project: its network <project>_router is used by name.
ASTERISM_PROJECT=asterism

# The container's memory limit (docs/install.md, "Memory").
TUTOR_MEM_LIMIT=256m

# The day of the daily limits (and of the records' files) is this time
# zone's date: a new day at 00:00 in Japan. The container's TZ comes from
# this line (docker-compose.yml), not from a TZ line.
TUTOR_TZ=Asia/Tokyo

# The router: the console's .tar (a registry row "tutor" with the role
# tutor-host), put in credentials/ next to this file (chown 1000:1000,
# chmod 600). The router is zenohd on the console's network
# (TUTOR_ROUTER, default tls/zenohd:7448), not the public name in the .tar.
ASTERISM_TUTOR_CREDENTIALS=/credentials/tutor.tar
# TUTOR_ROUTER=tls/zenohd:7448
# The node ID (default tutor): the same as the registry row's name, which
# is the certificate's (the role's ${node} is that name). A device looks
# for */tutor/helper, any node.
# ASTERISM_TUTOR_NODE=tutor

# The devices that may ask: their node IDs, comma separated (the same ones
# that have the role "tutor" in the console). "*" lets any node that
# reaches the helper ask; the router's ACL (the role) still decides who
# reaches it.
ASTERISM_TUTOR_DEVICES=fmruby-aaaaaa

# The LLM: "anthropic" with the key below, or "fake" (no LLM: canned
# answers, for trying the setup). A key of the tutor's own, not the game
# host's (its cost is seen and stopped apart). Keep this file chmod 600;
# the key goes nowhere else (not in the image, the records or the log).
ASTERISM_TUTOR_LLM=anthropic
ANTHROPIC_API_KEY=
# ASTERISM_TUTOR_MODEL=claude-haiku-5-5

# The daily limits: requests per device, and the estimated cost of all
# devices (USD). Over them, a device is told why.
# ASTERISM_TUTOR_PER_DAY=50
# ASTERISM_TUTOR_COST_PER_DAY=1.0

# "Make" (a whole app) and "fix it for me" (code put in the editor): false
# turns them off; asking, and hints as comments, stay.
# ASTERISM_TUTOR_MAKE=true
# ASTERISM_TUTOR_FIX=true

# On SIGTERM (docker compose stop, update.sh), seconds the requests being
# worked on get to end; keep it under the compose file's stop_grace_period (15 s).
# ASTERISM_TUTOR_STOP_GRACE=8

# The knowledge: the tutor clones the Family mruby sources from GitHub (at
# start and once a day, into the volume "sources") and makes the bundle from
# them; the LLM may search and read them (up to 4 rounds a request). false
# turns that off: the bundle in the image, no look-ups.
# ASTERISM_TUTOR_SOURCES=true
# ASTERISM_TUTOR_LOOKUP_ROUNDS=4

# Every other setting (README "Settings") in a TOML file of your own,
# mounted into the container, named here:
# ASTERISM_TUTOR_CONFIG=/credentials/tutor.toml
